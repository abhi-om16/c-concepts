#include <iostream>
#include <vector>
using namespace std;

int main() 
{
    int i,j,n;
    cout << "Welcome to e-commerce platform\n";
    cout << "How many products are there?: ";
    cin >> n;
    vector<int> a(n);
    for(i=0;i<n;i++){
        cout << "Product " << i+1 << " Price: ";
        cin >> a[i];
    }
    int choice;
    cout <<"How you want to view the prices?(1-3): \n";
    cout <<"1.Increasing\n2.Decreasing\n";
    cin >> choice;
    if(choice == 1){
        for(i=1;i<n;i++){
            int curr = a[i];
            int prev = i-1;
            while(prev >= 0 && a[prev] > curr){
                a[prev + 1]=a[prev];
                prev--;
            }
            a[prev + 1]=curr;
        }
        cout << "Prices: \n";
        for(i=0;i<n;i++){
            cout << a[i] << " ";
        }
    }
    else if(choice == 2){
        for(i=0;i<n-1;i++){
            int max = i;
            for(j=i+1;j<n;j++){
                if(a[j] > a[max]){
                    max = j;
                }
            }
            int temp = a[i];
            a[i] = a[max];
            a[max] = temp;
        }
        for(i=0;i<n;i++){
            cout << a[i] <<" ";
        }
    }
    else{
        cout << "Please select between 1 and 2 only";
    }
    

    return 0;
}
